SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Camera Sources ────────────────────────────────────────────────────────
# Simulation mode (USB webcams):
#   CAM_1_URL=0   → first webcam
#   CAM_2_URL=1   → second webcam
#
# Real CCTV RTSP mode:
#   CAM_1_URL=rtsp://admin:password@192.168.1.100:554/h264/ch1/main/av_stream
#   CAM_2_URL=rtsp://admin:password@192.168.1.101:554/h264/ch1/main/av_stream
#
# MediaMTX RTSP simulation (webcam → virtual RTSP server):
#   CAM_1_URL=rtsp://localhost:8554/cctv_lantai1
#   CAM_2_URL=rtsp://localhost:8554/cctv_lantai2

CAM_1_URL=0
CAM_2_URL=1
